<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0</TargetFramework>

    <Nullable>enable</Nullable>

    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>

    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>

    <PublishReadyToRun>false</PublishReadyToRun>

    <UseRidGraph>true</UseRidGraph>
  </PropertyGroup>


  <!-- ==========================================================
       AVALONIA / APPLICATION RESOURCES
       ========================================================== -->

  <ItemGroup>

    <AvaloniaResource Include="Assets\**" />

  </ItemGroup>


  <!-- ==========================================================
       PACKAGES
       ========================================================== -->

  <ItemGroup>

    <PackageReference Include="alglib.net"
                      Version="3.19.0" />

    <PackageReference Include="Avalonia"
                      Version="11.3.10" />

    <PackageReference Include="Avalonia.Controls.ColorPicker"
                      Version="11.3.10" />

    <PackageReference Include="Avalonia.Controls.DataGrid"
                      Version="11.3.10" />

    <PackageReference Include="Avalonia.Desktop"
                      Version="11.3.10" />

    <PackageReference Include="Avalonia.Themes.Fluent"
                      Version="11.3.10" />

    <PackageReference Include="Avalonia.Fonts.Inter"
                      Version="11.3.10" />

    <PackageReference Include="Avalonia.Diagnostics"
                      Version="11.3.10">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>

    <PackageReference Include="CommunityToolkit.Mvvm"
                      Version="8.2.1" />

    <PackageReference Include="Material.Icons.Avalonia"
                      Version="3.0.0-preview5" />

    <PackageReference Include="MathNet.Numerics"
                      Version="6.0.0-beta2" />

    <PackageReference Include="Microsoft.Extensions.Caching.Memory"
                      Version="10.0.2" />

    <PackageReference Include="Microsoft.Extensions.DependencyInjection"
                      Version="10.0.1" />

    <PackageReference Include="Microsoft.Extensions.Http"
                      Version="10.0.1" />

    <PackageReference Include="OneWare.OpenCvSharp4.runtime.osx-arm64"
                      Version="4.13.0.18" />

    <PackageReference Include="OneWare.OpenCvSharp4.runtime.osx-x64"
                      Version="4.13.0.18" />

    <PackageReference Include="OpenCvSharp4"
                      Version="4.13.0.20260308" />

    <PackageReference Include="OpenCvSharp4.official.runtime.ubuntu.24.04-x64"
                      Version="4.13.0.20260308"
                      GeneratePathProperty="true" />

    <PackageReference Include="OpenCvSharp4.runtime.win"
                      Version="4.13.0.20260302" />

  </ItemGroup>


  <!-- ==========================================================
       LINUX OPENCV NATIVE LIBRARY
       ========================================================== -->

  <ItemGroup>

    <Content
      Include="$(PkgOpenCvSharp4_official_runtime_ubuntu_24_04-x64)\runtimes\ubuntu.24.04-x64\native\libOpenCvSharpExtern.so"
      Condition="'$(RuntimeIdentifier)' == 'linux-x64' Or '$(RuntimeIdentifier)' == 'ubuntu.24.04-x64'">

      <Link>libOpenCvSharpExtern.so</Link>

      <CopyToOutputDirectory>Always</CopyToOutputDirectory>

      <PublishState>Included</PublishState>

    </Content>

  </ItemGroup>


  <!-- ==========================================================
       RESX
       ========================================================== -->

  <ItemGroup>

    <EmbeddedResource Update="Assets\Strings.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>Strings.Designer.cs</LastGenOutput>
    </EmbeddedResource>

    <EmbeddedResource Update="Assets\Strings.it.resx">
      <LastGenOutput>Strings.Designer.cs</LastGenOutput>
    </EmbeddedResource>

  </ItemGroup>


  <ItemGroup>

    <Compile Update="Assets\Strings.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Strings.resx</DependentUpon>
    </Compile>

  </ItemGroup>


  <!-- ==========================================================
       macOS ARM64 .APP BUNDLE
       ========================================================== -->

  <Target
    Name="CreateMacAppBundle"
    AfterTargets="Publish"
    Condition="'$(RuntimeIdentifier)' == 'osx-arm64'">

    <PropertyGroup>

      <MacPublishDir>$(PublishDir)</MacPublishDir>

      <MacAppDir>$(MSBuildProjectDirectory)\bin\$(Configuration)\$(TargetFramework)\$(RuntimeIdentifier)\$(AssemblyName).app</MacAppDir>

      <MacAppContents>$(MacAppDir)\Contents</MacAppContents>

      <MacAppMacOS>$(MacAppContents)\MacOS</MacAppMacOS>

      <MacAppResources>$(MacAppContents)\Resources</MacAppResources>

    </PropertyGroup>


    <!-- Remove previous bundle -->

    <RemoveDir
      Directories="$(MacAppDir)"
      Condition="Exists('$(MacAppDir)')" />


    <!-- Create bundle directories -->

    <MakeDir
      Directories="$(MacAppMacOS);$(MacAppResources)" />


    <!-- Copy published .NET files into Contents/MacOS -->

    <ItemGroup>

      <MacPublishFiles
        Include="$(MacPublishDir)**\*"
        Exclude="$(MacPublishDir)$(AssemblyName).app\**" />

    </ItemGroup>


    <Copy
      SourceFiles="@(MacPublishFiles)"
      DestinationFiles="@(MacPublishFiles->'$(MacAppMacOS)\%(RecursiveDir)%(Filename)%(Extension)')" />


    <!-- Copy macOS icon -->

    <Copy
      SourceFiles="$(MSBuildProjectDirectory)\Assets\Icon\icon.icns"
      DestinationFolder="$(MacAppResources)"
      SkipUnchangedFiles="true"
      Condition="Exists('$(MSBuildProjectDirectory)\Assets\Icon\icon.icns')" />


    <!-- ========================================================
         Info.plist
         ======================================================== -->

    <WriteLinesToFile
      File="$(MacAppContents)\Info.plist"
      Overwrite="true"
      Lines="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?&gt;;
&lt;!DOCTYPE plist PUBLIC &quot;-//Apple//DTD PLIST 1.0//EN&quot; &quot;http://www.apple.com/DTDs/PropertyList-1.0.dtd&quot;&gt;;
&lt;plist version=&quot;1.0&quot;&gt;;
&lt;dict&gt;;
&lt;key&gt;CFBundleExecutable&lt;/key&gt;;
&lt;string&gt;$(AssemblyName)&lt;/string&gt;;
&lt;key&gt;CFBundleIdentifier&lt;/key&gt;;
&lt;string&gt;com.genofabio.kometra&lt;/string&gt;;
&lt;key&gt;CFBundleName&lt;/key&gt;;
&lt;string&gt;$(AssemblyName)&lt;/string&gt;;
&lt;key&gt;CFBundleDisplayName&lt;/key&gt;;
&lt;string&gt;$(AssemblyName)&lt;/string&gt;;
&lt;key&gt;CFBundlePackageType&lt;/key&gt;;
&lt;string&gt;APPL&lt;/string&gt;;
&lt;key&gt;CFBundleIconFile&lt;/key&gt;;
&lt;string&gt;icon.icns&lt;/string&gt;;
&lt;key&gt;CFBundleShortVersionString&lt;/key&gt;;
&lt;string&gt;1.0.2&lt;/string&gt;;
&lt;key&gt;CFBundleVersion&lt;/key&gt;;
&lt;string&gt;1.0.2&lt;/string&gt;;
&lt;key&gt;LSMinimumSystemVersion&lt;/key&gt;;
&lt;string&gt;12.0&lt;/string&gt;;
&lt;/dict&gt;;
&lt;/plist&gt;" />


    <!-- Ensure executable permission -->

    <Exec
      Command="chmod +x &quot;$(MacAppMacOS)\$(AssemblyName)&quot;"
      Condition="Exists('$(MacAppMacOS)\$(AssemblyName)')" />


    <Message
      Importance="high"
      Text="macOS ARM64 APP created: $(MacAppDir)" />

  </Target>

</Project>
